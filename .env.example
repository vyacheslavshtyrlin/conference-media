# DEPLOY_ENV_PROD.

NODE_ENV=production
PORT=4000

SIGNALING_BIND_ADDR=0.0.0.0

# Redis 
# Пароль Redis (requirepass). Должен совпадать с паролем в REDIS_URL у бэка (conference-be).
REDIS_PASSWORD=replace-with-a-strong-random-redis-password
REDIS_BIND_ADDR=0.0.0.0

# Общий секрет join-токенов. ДОЛЖЕН совпадать с JOIN_TOKEN_SECRET у api.
JOIN_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Grace очистки пустых комнат, мс.
ROOM_EMPTY_GRACE_MS=10000

# Разрешённый origin WebSocket = публичный URL веб-приложения.
WS_ALLOWED_ORIGINS=https://conference.victoryspace.ru

# TLS
MEDIA_DOMAIN=media.victoryspace.ru
# email для уведомлений.
CERTBOT_EMAIL=admin@example.com

# mediasoup: listen IP и публичный IP/DNS, видимый браузерами.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=158.160.10.26
# Optional address advertised only to recording-bot. Defaults to the public address.
MEDIASOUP_BOT_ANNOUNCED_IP=158.160.10.26

# Диапазон RTC-портов mediasoup (должен быть открыт в фаерволе host A).
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
# Total mediasoup worker budget. With recording enabled, one worker is reserved for recording (minimum 2).
MEDIASOUP_NUM_WORKERS=2

TURN_URLS=turn:158.160.10.26:3478?transport=udp,turn:158.160.10.26:3478?transport=tcp
TURN_USERNAME=replace-with-turn-username
TURN_PASSWORD=replace-with-a-strong-random-turn-password
TURN_REALM=158.160.10.26
TURN_MIN_PORT=50000
TURN_MAX_PORT=50100

# Recording runtime: five capture workers on the separate recording host.
MEDIA_NODE_ID=media-prod-1
RECORDING_CONTROL_URL=https://conference.victoryspace.ru/internal/v1
RECORDING_BOT_WORKERS_JSON=[{"workerId":"recording-worker-1","controlUrl":"https://recorder.victoryspace.ru/workers/1","capacity":10},{"workerId":"recording-worker-2","controlUrl":"https://recorder.victoryspace.ru/workers/2","capacity":10},{"workerId":"recording-worker-3","controlUrl":"https://recorder.victoryspace.ru/workers/3","capacity":10},{"workerId":"recording-worker-4","controlUrl":"https://recorder.victoryspace.ru/workers/4","capacity":10},{"workerId":"recording-worker-5","controlUrl":"https://recorder.victoryspace.ru/workers/5","capacity":10}]
RECORDING_WORKER_LEASE_TTL_MS=15000
RECORDING_WORKER_HEARTBEAT_MS=5000
RECORDING_BOT_SIGNALING_URL=wss://media.victoryspace.ru/internal/recording-bot/v1
RECORDING_CONTROL_JWT_HS256_SECRET=replace-with-at-least-32-random-characters
RECORDING_BOT_ADMISSION_JWT_HS256_SECRET=replace-with-at-least-32-random-characters
RECORDING_BOT_CONTROL_JWT_HS256_SECRET=replace-with-at-least-32-random-characters
