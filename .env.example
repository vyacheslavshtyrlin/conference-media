# DEPLOY_ENV_PROD.

NODE_ENV=production
PORT=4000

SIGNALING_BIND_ADDR=0.0.0.0

# Redis 
# Пароль Redis (requirepass). Должен совпадать с паролем в REDIS_URL у бэка (conference-be).
REDIS_PASSWORD=redisREDIS111
REDIS_BIND_ADDR=0.0.0.0

# Общий секрет join-токенов. ДОЛЖЕН совпадать с JOIN_TOKEN_SECRET у api.
JOIN_TOKEN_SECRET=477334ce7b8eed1518fce56d1ca284688064d72b685491ecbe295cae24e831b9

# Grace очистки пустых комнат, мс.
ROOM_EMPTY_GRACE_MS=10000

# Разрешённый origin WebSocket = публичный URL веб-приложения.
WS_ALLOWED_ORIGINS=https://conference.victoryspace.ru

# TLS
MEDIA_DOMAIN=media.victoryspace.ru
# email для уведомлений.
CERTBOT_EMAIL=mukatov.talgat@yandex.ru

# mediasoup: listen IP и публичный IP/DNS, видимый браузерами.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=158.160.10.26

# Диапазон RTC-портов mediasoup (должен быть открыт в фаерволе host A).
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
# Total mediasoup worker budget. With recording enabled, one worker is reserved for recording (minimum 2).
MEDIASOUP_NUM_WORKERS=2

TURN_URLS=turn:158.160.10.26:3478?transport=udp,turn:158.160.10.26:3478?transport=tcp
TURN_USERNAME=conference
TURN_PASSWORD=conference
TURN_REALM=158.160.10.26
TURN_MIN_PORT=50000
TURN_MAX_PORT=50100
