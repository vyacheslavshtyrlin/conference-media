# Media/signaling service environment
# Copy to .env for local service-only development.

# Local service-only development: development.
# Production: use production, as shown in deploy/env/two-server.env.example.
NODE_ENV=development
PORT=4000

# Docker image used by docker-compose.yml in deploy mode.
# Production: change registry/project/tag if the image name differs.
MEDIA_IMAGE=registry.git.victory-crm.ru/conference/media:latest

# Redis used for serializable room/session state.
# Local service-only development without bundled Redis: localhost.
REDIS_URL=redis://localhost:6379
# Used by docker-compose.yml when signaling runs with bundled Redis.
# Production media server with this compose usually keeps this value.
MEDIA_REDIS_URL=redis://redis:6379

# Must match the API service.
# Production: change to a strong shared secret and use the same value in api/.env.
JOIN_TOKEN_SECRET=change-me-for-local-development

# Empty-room cleanup grace period.
# Usually keep unless room cleanup policy changes.
ROOM_EMPTY_GRACE_MS=60000

# WebSocket runtime guardrails.
# Usually keep guardrails; change WS_ALLOWED_ORIGINS to the public web origin in production.
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_SEND_BACKPRESSURE_BYTES=262144
WS_RATE_LIMIT_WINDOW_MS=10000
WS_RATE_LIMIT_MAX_MESSAGES=60
WS_ALLOWED_ORIGINS=http://localhost:5173

# mediasoup WebRTC ports and limits.
# Usually keep listen IP and limits.
# Production: MEDIASOUP_ANNOUNCED_IP must be the public media server IP/DNS reachable by browsers.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# Firewall/security group must open this exact RTC range.
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
MEDIASOUP_NUM_WORKERS=2
MEDIASOUP_MAX_TRANSPORTS_PER_PEER=4
MEDIASOUP_MAX_PRODUCERS_PER_PEER=3
MEDIASOUP_MAX_CONSUMERS_PER_PEER=32

# TURN ICE server config sent to browsers.
# Production: change TURN_URLS and TURN_REALM to the public media/TURN DNS name.
# Production: change TURN_PASSWORD; TURN_USERNAME can usually stay "conference".
# Firewall/security group must open 3478/tcp, 3478/udp and TURN_MIN_PORT-TURN_MAX_PORT/udp.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_USERNAME=conference
TURN_PASSWORD=conference
TURN_REALM=conference.local
TURN_MIN_PORT=50000
TURN_MAX_PORT=50100
