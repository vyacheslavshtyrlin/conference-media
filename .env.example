# Media/signaling service environment
# Copy to .env for local service-only development.

NODE_ENV=development
PORT=4000

# Docker image used by docker-compose.yml in deploy mode.
MEDIA_IMAGE=ghcr.io/commmmet/conference-media:latest

# Redis used for serializable room/session state.
REDIS_URL=redis://localhost:6379
# Used by docker-compose.yml when signaling runs with bundled Redis.
MEDIA_REDIS_URL=redis://redis:6379

# Must match the API service.
JOIN_TOKEN_SECRET=change-me-for-local-development

# Empty-room cleanup grace period.
ROOM_EMPTY_GRACE_MS=60000

# WebSocket runtime guardrails.
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_SEND_BACKPRESSURE_BYTES=262144
WS_RATE_LIMIT_WINDOW_MS=10000
WS_RATE_LIMIT_MAX_MESSAGES=60
WS_ALLOWED_ORIGINS=http://localhost:5173

# mediasoup WebRTC ports and limits.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
MEDIASOUP_NUM_WORKERS=2
MEDIASOUP_MAX_TRANSPORTS_PER_PEER=4
MEDIASOUP_MAX_PRODUCERS_PER_PEER=3
MEDIASOUP_MAX_CONSUMERS_PER_PEER=32

# TURN ICE server config sent to browsers.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_USERNAME=conference
TURN_PASSWORD=conference
TURN_REALM=conference.local
